generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  DEALER
}

model User {
  id             String   @id @default(uuid()) @db.Uuid
  email          String   @unique
  passwordHash   String
  name           String
  dealershipName String?
  role           UserRole
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
